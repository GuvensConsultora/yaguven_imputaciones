<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_imputaciones" model="ir.actions.report">
        <field name="name">Detalle de imputaciones</field>
        <field name="model">yaguven.imputaciones.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yaguven_imputaciones.report_imputaciones</field>
        <field name="report_file">yaguven_imputaciones.report_imputaciones</field>
        <field name="print_report_name">'Imputaciones - %s' % (object.partner_id.display_name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════════
         El documento se lee como un extracto, no como 74 tablitas.

         Cada comprobante es UNA línea con UN importe, y lo que lo explica cuelga
         debajo con sangría: las líneas de abajo suman la de arriba. Esa es toda la
         gramática del documento, y se aprende en el primer bloque.

         Lo que se sacó, y por qué:
         - El encabezado de columnas se repetía en cada bloque. Setenta y cuatro veces
           el mismo rótulo impide ver el patrón. Va una vez, arriba.
         - «Total de la factura» y «Saldo de la factura» en la vista por recibo hablan
           de la factura entera y no del pago que se está mirando: había que aclarar por
           escrito que no se restaban. Un dato que necesita esa nota está de más acá —
           vive en la otra vista, que es donde se pregunta por la factura.
         - Cuatro importes por bloque obligan a elegir cuál mirar antes de entender.

         NADA se distingue por color: la jerarquía la dan la sangría, la negrita y las
         palabras («cubre», «pagado con», «queda a cuenta»). En blanco y negro, o para
         quien no separa los colores, dice exactamente lo mismo.
         ════════════════════════════════════════════════════════════════════════ -->
    <template id="report_imputaciones">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="es_pago" t-value="doc.vista == 'pago'"/>

                        <h2 style="margin-bottom:0;">
                            <span t-if="es_pago">Detalle de pagos aplicados</span>
                            <span t-else="">Detalle de imputaciones</span>
                        </h2>
                        <div class="row mt8 mb8">
                            <div class="col-7">
                                <strong t-field="doc.partner_id.display_name"/><br/>
                                <span t-if="doc.partner_id.vat">CUIT <span t-field="doc.partner_id.vat"/><br/></span>
                                <span>Cuenta: <span t-field="doc.tipo"/></span>
                            </div>
                            <div class="col-5 text-end">
                                <span t-if="doc.date_from or doc.date_to">
                                    Período:
                                    <span t-if="doc.date_from" t-field="doc.date_from"/>
                                    <span t-else="">inicio</span>
                                    a
                                    <span t-if="doc.date_to" t-field="doc.date_to"/>
                                    <span t-else="">hoy</span>
                                    <br/>
                                </span>
                                <span t-else="">Toda la cuenta corriente<br/></span>
                                Emitido: <span t-esc="fecha(context_timestamp(datetime.datetime.now()))"/>
                            </div>
                        </div>

                        <!-- La nota explica la gramática del documento, no las columnas:
                             quien entiende que lo de abajo suma lo de arriba ya puede
                             leer cualquier bloque sin volver acá. -->
                        <div style="background-color:#f7f7f7; border-left:3px solid #9ca3af;
                                    padding:6px 10px; margin-bottom:12px; font-size:9.5pt;
                                    color:#4b5563;">
                            <t t-if="es_pago">
                                Cada línea en negrita es <strong>un pago</strong>. Debajo, con sangría,
                                las facturas que cubrió: <strong>las de abajo suman la de arriba</strong>.
                                Lo que no se aplicó a ninguna figura como «queda a cuenta».
                            </t>
                            <t t-else="">
                                Cada línea en negrita es <strong>un comprobante</strong>. Debajo, con
                                sangría, los pagos, notas de crédito y ajustes que lo cancelaron:
                                <strong>las de abajo suman la de arriba</strong>. Lo que falta cancelar
                                figura como «queda debiendo».
                            </t>
                        </div>

                        <!-- Encabezado de columnas: UNA sola vez en todo el documento.
                             Los anchos se repiten a mano en cada bloque porque cada uno
                             es su propia tabla (ver el div de abajo). -->
                        <table class="table table-sm" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th style="width:13%;">Fecha</th>
                                    <th style="width:62%;">
                                        <span t-if="es_pago">Pago, y las facturas que cubrió</span>
                                        <span t-else="">Comprobante, y con qué se canceló</span>
                                    </th>
                                    <th class="text-end" style="width:25%;">Importe</th>
                                </tr>
                            </thead>
                        </table>

                        <!-- ═════════ POR RECIBO ═════════ -->
                        <t t-if="es_pago">
                            <t t-set="pagos" t-value="por_pago[doc.id]"/>
                            <t t-if="not pagos">
                                <p>No hay pagos con imputaciones en el período elegido.</p>
                            </t>

                            <!-- Un div por pago, para que el motor no parta el grupo entre
                                 dos hojas dejando las facturas sin su pago arriba. -->
                            <t t-foreach="pagos" t-as="p">
                              <div style="page-break-inside:avoid; break-inside:avoid;">
                                <table class="table table-sm" style="margin-bottom:0;">
                                    <!-- La línea del pago va en el `thead` para que, si el
                                         grupo no entra en una hoja, el motor la repita
                                         arriba de la siguiente: sin eso la página arranca
                                         con un «cubre …» que no dice de qué pago es. -->
                                    <thead>
                                        <tr style="background-color:#f2f2f2;">
                                            <td style="width:13%;"><strong><span t-esc="fecha(p['fecha'])"/></strong></td>
                                            <td style="width:62%;">
                                                <strong><span t-esc="p['move'].name"/></strong>
                                                <t t-if="p['diario_nombre']">
                                                    <span class="text-muted"> · <span t-esc="p['diario_nombre']"/></span>
                                                </t>
                                                <t t-if="p['cheque']">
                                                    <span class="text-muted"> · cheque </span><span t-esc="p['cheque']"/>
                                                </t>
                                            </td>
                                            <td class="text-end" style="width:25%;">
                                                <strong><span t-esc="plata(p['importe'])"/></strong>
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="p['aplicaciones']" t-as="a">
                                            <td/>
                                            <td style="padding-left:26px;">
                                                <span class="text-muted">cubre </span>
                                                <span t-esc="a.doc_move_id.name"/>
                                                <span class="text-muted"> del <span t-esc="fecha(a.doc_date)"/></span>
                                            </td>
                                            <td class="text-end"><span t-esc="plata(a.amount)"/></td>
                                        </tr>
                                        <tr t-if="p['sin_aplicar']">
                                            <td/>
                                            <td style="padding-left:26px;">
                                                <span class="text-muted">queda a cuenta, sin aplicar a ninguna factura</span>
                                            </td>
                                            <td class="text-end"><span t-esc="plata(p['sin_aplicar'])"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                              </div>
                            </t>

                            <t t-set="impagos" t-value="sin_imputar[doc.id]"/>
                            <t t-if="impagos">
                                <div style="page-break-inside:avoid; break-inside:avoid; margin-top:16px;">
                                    <h4 style="margin-bottom:2px;">Comprobantes todavía sin pagos aplicados</h4>
                                    <p class="text-muted" style="margin-bottom:4px; font-size:9.5pt;">
                                        Ningún pago se les aplicó todavía. Están acá para que la
                                        cuenta se lea completa.
                                    </p>
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr t-foreach="impagos" t-as="imp">
                                                <td style="width:13%;"><span t-esc="fecha(imp['fecha'])"/></td>
                                                <td style="width:62%;">
                                                    <span t-esc="imp['move'].name"/>
                                                    <t t-if="imp['move'].journal_id">
                                                        <span class="text-muted"> · <span t-esc="imp['move'].journal_id.display_name"/></span>
                                                    </t>
                                                </td>
                                                <td class="text-end" style="width:25%;"><span t-esc="plata(abs(imp['saldo']))"/></td>
                                            </tr>
                                            <tr>
                                                <td/>
                                                <td class="text-end"><strong>Total sin aplicar</strong></td>
                                                <td class="text-end"><strong><span t-esc="plata(sin_imputar_total[doc.id])"/></strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </t>

                        <!-- ═════════ POR FACTURA ═════════ -->
                        <t t-else="">
                            <t t-set="filas" t-value="detalle[doc.id]"/>
                            <t t-if="not filas">
                                <p>No hay comprobantes con imputaciones en el período elegido.</p>
                            </t>

                            <t t-foreach="filas" t-as="f">
                              <div style="page-break-inside:avoid; break-inside:avoid;">
                                <table class="table table-sm" style="margin-bottom:0;">
                                    <thead>
                                        <tr style="background-color:#f2f2f2;">
                                            <td style="width:13%;"><strong><span t-esc="fecha(f['fecha'])"/></strong></td>
                                            <td style="width:62%;">
                                                <strong><span t-esc="f['move'].name"/></strong>
                                                <t t-if="f['move'].journal_id">
                                                    <span class="text-muted"> · <span t-esc="f['move'].journal_id.display_name"/></span>
                                                </t>
                                            </td>
                                            <td class="text-end" style="width:25%;">
                                                <strong><span t-esc="plata(f['total'])"/></strong>
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="f['cancelaciones']" t-as="c">
                                            <td/>
                                            <td style="padding-left:26px;">
                                                <span class="text-muted">pagado con </span>
                                                <span t-esc="c.canc_move_id.name"/>
                                                <span class="text-muted"> del <span t-esc="fecha(c.canc_date)"/></span>
                                                <t t-if="c.cheque">
                                                    <span class="text-muted">, cheque </span><span t-esc="c.cheque"/>
                                                </t>
                                            </td>
                                            <td class="text-end"><span t-esc="plata(c.amount)"/></td>
                                        </tr>
                                        <tr t-if="abs(f['saldo']) &gt;= 0.01">
                                            <td/>
                                            <td style="padding-left:26px;">
                                                <span class="text-muted">queda debiendo</span>
                                            </td>
                                            <td class="text-end"><span t-esc="plata(abs(f['saldo']))"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                              </div>
                            </t>

                            <!-- Por recibo esta sección no va: los pagos a cuenta ya salen
                                 arriba, en la línea «queda a cuenta» de su propio pago. -->
                            <t t-set="cuenta" t-value="a_cuenta[doc.id]"/>
                            <t t-if="cuenta">
                                <div style="page-break-inside:avoid; break-inside:avoid; margin-top:16px;">
                                    <h4 style="margin-bottom:2px;">Pagos con saldo a cuenta</h4>
                                    <p class="text-muted" style="margin-bottom:4px; font-size:9.5pt;">
                                        Están cobrados/pagados pero todavía no aplicados contra un
                                        comprobante.
                                    </p>
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr t-foreach="cuenta" t-as="l">
                                                <td style="width:13%;"><span t-esc="fecha(l.date)"/></td>
                                                <td style="width:62%;">
                                                    <span t-esc="l.move_id.name"/>
                                                    <span class="text-muted"> · de <span t-esc="plata(l.debit or l.credit)"/> quedó sin aplicar</span>
                                                </td>
                                                <td class="text-end" style="width:25%;"><span t-esc="plata(abs(l.amount_residual))"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </t>

                        <!-- Leyenda de códigos: se busca acá recién al toparse con uno que
                             no se reconoce, así que va al final. Sale de los diarios del
                             propio documento: no hay tabla que mantener. -->
                        <t t-set="refs" t-value="referencias[doc.id]"/>
                        <t t-if="refs">
                            <div style="break-inside:avoid; page-break-inside:avoid; margin-top:20px;
                                        border-top:1px solid #d1d5db; padding-top:8px;
                                        font-size:9pt; color:#4b5563;">
                                <strong style="color:#374151;">Qué es cada código de comprobante</strong>
                                <table class="table table-sm" style="margin-top:4px; font-size:9pt;">
                                    <tbody>
                                        <tr t-foreach="refs" t-as="r">
                                            <td style="width:34%; border:0; padding:2px 0;">
                                                <span t-esc="r['ejemplo']"/>
                                            </td>
                                            <td style="border:0; padding:2px 0;">
                                                <span t-esc="r['diario']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
