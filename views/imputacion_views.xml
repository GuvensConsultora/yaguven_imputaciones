<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="yaguven_imputacion_view_list" model="ir.ui.view">
        <field name="name">yaguven.imputacion.list</field>
        <field name="model">yaguven.imputacion</field>
        <field name="arch" type="xml">
            <list string="Imputaciones" create="false" edit="false" delete="false"
                  default_order="doc_date, doc_move_id, date">
                <field name="partner_id" optional="show"/>
                <field name="tipo" optional="hide"/>
                <field name="doc_move_id" string="Comprobante"/>
                <field name="doc_date" string="Fecha"/>
                <field name="doc_total" string="Total" optional="show"/>
                <field name="canc_move_id" string="Cancelado con"/>
                <field name="canc_date" string="Fecha de pago"/>
                <field name="cheque" optional="show"/>
                <field name="journal_id" optional="hide"/>
                <field name="amount" string="Imputado" sum="Imputado"/>
                <field name="doc_residual" string="Saldo del comprobante" optional="show"/>
                <field name="doc_state" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- OJO ODOO 19: dentro de <search> ya NO vale <group string="Agrupar por">; los
         filtros de agrupacion van sueltos. Con <group> la vista no valida y el error que
         devuelve el servidor es «definicion no valida», sin decir que nodo es. -->
    <record id="yaguven_imputacion_view_search" model="ir.ui.view">
        <field name="name">yaguven.imputacion.search</field>
        <field name="model">yaguven.imputacion</field>
        <field name="arch" type="xml">
        <search string="Imputaciones">
            <field name="partner_id"/>
            <field name="doc_move_id" string="Comprobante"/>
            <field name="canc_move_id" string="Cancelado con"/>
            <filter name="f_proveedor" string="Proveedores" domain="[('tipo', '=', 'proveedor')]"/>
            <filter name="f_cliente" string="Clientes" domain="[('tipo', '=', 'cliente')]"/>
            <separator/>
            <filter name="f_este_anio" string="Este año"
                    domain="[('doc_date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
            <separator/>
            <filter name="g_partner" string="Contacto" context="{'group_by': 'partner_id'}"/>
            <filter name="g_doc" string="Comprobante" context="{'group_by': 'doc_move_id'}"/>
            <filter name="g_canc" string="Cancelado con" context="{'group_by': 'canc_move_id'}"/>
            <filter name="g_fecha" string="Fecha del comprobante" context="{'group_by': 'doc_date:month'}"/>
        </search>
        </field>
    </record>

    <!-- Las dos entradas miran la MISMA lista: lo único que cambia es por dónde se
         agrupa. Existen separadas porque pedirle al operador que cambie el agrupamiento
         a mano es justamente lo que no se entiende de la pantalla de conciliación. -->
    <record id="yaguven_imputacion_action" model="ir.actions.act_window">
        <field name="name">Imputaciones por factura</field>
        <field name="res_model">yaguven.imputacion</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_g_partner': 1, 'search_default_g_doc': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay imputaciones para mostrar</p>
            <p>Acá aparece, factura por factura, con qué pagos se canceló y por cuánto.</p>
        </field>
    </record>

    <record id="yaguven_imputacion_por_pago_action" model="ir.actions.act_window">
        <field name="name">Imputaciones por recibo</field>
        <field name="res_model">yaguven.imputacion</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_g_partner': 1, 'search_default_g_canc': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay imputaciones para mostrar</p>
            <p>Acá aparece, pago por pago, qué facturas cubrió y por cuánto.</p>
        </field>
    </record>

    <menuitem id="yaguven_imputacion_menu_raiz"
              name="Imputaciones de cuenta corriente"
              parent="account.menu_finance_reports"
              sequence="95"/>

    <menuitem id="yaguven_imputacion_menu"
              name="Por factura: con qué se canceló cada una"
              parent="yaguven_imputacion_menu_raiz"
              action="yaguven_imputacion_action"
              sequence="10"/>

    <menuitem id="yaguven_imputacion_por_pago_menu"
              name="Por recibo: qué facturas cubrió cada pago"
              parent="yaguven_imputacion_menu_raiz"
              action="yaguven_imputacion_por_pago_action"
              sequence="20"/>

</odoo>
